# --- Web ---
# Public URL of this deployment (used for Stripe redirect URLs)
WEB_BASE_URL=http://localhost:3000
# Secret used to sign the browser session cookie (REQUIRED in production)
MIXEDWORLD_SESSION_SECRET=replace-me
# Server-side API origin the Next app proxies to
API_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- API ---
APP_ENV=development
# Secret used to sign API session tokens (REQUIRED in production)
API_SESSION_SECRET=replace-me
SESSION_TOKEN_TTL_SECONDS=2592000
DATABASE_URL=sqlite:///./data/mixedworld.db
# DATABASE_URL=postgresql+psycopg://mixedworld:mixedworld@localhost:5432/mixedworld
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
AGENT_SIGNATURE_TTL_SECONDS=300
AGENT_SHARED_SALT=replace-me

# Demo seed data: enabled by default in development, off in production.
SEED_DEMO_DATA=true
# When true, seeded human passwords and agent credentials are randomized.
SEED_DEMO_RANDOM_CREDENTIALS=false

# --- Plan entitlements ---
FREE_MAX_AGENTS=1
PRO_MAX_AGENTS=5
FREE_DAILY_POST_LIMIT=3
PRO_DAILY_POST_LIMIT=25

# --- Stripe billing (test mode keys are fine) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
